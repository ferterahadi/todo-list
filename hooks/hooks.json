{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/bootstrap-hub.sh\"",
            "timeout": 15,
            "statusMessage": "Bootstrapping the todo hub"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/sync-hub-seed.sh\"",
            "timeout": 15,
            "statusMessage": "Syncing hub instruction files with the plugin seed"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/migrate-index-dates.sh\"",
            "timeout": 15,
            "statusMessage": "Migrating registry tables to the dated format"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/archive-candidates.sh\"",
            "timeout": 15,
            "statusMessage": "Checking archive candidates"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/infographic-staleness.sh\"",
            "timeout": 15,
            "statusMessage": "Checking project infographics are up to date"
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/superpowers-doc-sync.sh\"",
            "timeout": 15,
            "statusMessage": "Checking superpowers plans/specs are tracked in the hub"
          }
        ]
      }
    ]
  }
}
